izer/v2/Z2MLQWGOOZGCXI2LS7DECD3PW4.jpeg?auth=8ca9da7d59ca75426d816499c4c7a373436d2df7007d72f413deece184310e34?height=1200&width=1200", "height": "1200", "width": "1200"}]}, {"@type": "BlogPosting", "headline": "Temblor en Per\u00fa hoy, lunes 26 de octubre: epicentro, hora y magnitud seg\u00fan el IGP", "datePublished": "2026-10-25T09:45:19-0500", "dateModified": "2026-10-25T09:45:19-0500", "alternateName": "Mira aqu\u00ed los reportes del Instituto Geof\u00edsico del Per\u00fa (IGP) sobre los \u00faltimos sismos en el pa\u00eds. ", "mainEntityOfPage": {"@type": "WebPage", "@id": ""}, "@id": "#liveblog-397155", "author": [{"@type": "Person", "@id": "#author", "name": "Redacci\u00f3n EC", "url": "https://elcomercio.pe/autor/redaccion-ec/"}], "publisher": {"@type": "Organization", "@id": "#organization"}, "url": "https://elcomercio.pe/respuestas/hoy-temblor-en-peru-en-vivo-ultimos-sismos-25-y-26-de-octubre-2026-hora-magnitud-y-epicentro-del-reporte-segun-el-igp-instituto-geofisico-del-peru-lima-callao-ica-lbposting-noticia/#liveblog-397155", "articleBody": "\t<ul class='story-contents__paragraph-list'>\n<li>El Per\u00fa est\u00e1 ubicado en una zona s\u00edsmica y la ocurrencia de sismos es inevitable. Un estudio del IGP indica que existe energ\u00eda s\u00edsmica acumulada en el sur del pa\u00eds, lo que debe incentivarlos a participar en simulacros.\n</li></ul>\n\n", "image": [{"@type": "ImageObject", "url": "/resizer/v2/Z2MLQWGOOZGCXI2LS7DECD3PW4.jpeg?auth=8ca9da7d59ca75426d816499c4c7a373436d2df7007d72f413deece184310e34?height=675&width=1200", "height": "675", "width": "1200"}, {"@type": "ImageObject", "url": "/resizer/v2/Z2MLQWGOOZGCXI2LS7DECD3PW4.jpeg?auth=8ca9da7d59ca75426d816499c4c7a373436d2df7007d72f413deece184310e34?height=900&width=1200", "height": "900", "width": "1200"}, {"@type": "ImageObject", "url": "/resizer/v2/Z2MLQWGOOZGCXI2LS7DECD3PW4.jpeg?auth=8ca9da7d59ca75426d816499c4c7a373436d2df7007d72f413deece184310e34?height=1200&width=1200", "height": "1200"